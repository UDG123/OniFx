# ==========================================================================
# OniQuant v6.0 — IBeam/IB Gateway Headless Container
# ==========================================================================
# Runs IB Gateway headlessly via Xvfb on Railway.app.
# Auto-authenticates 2FA via oathtool TOTP generation.
# ==========================================================================

FROM voyz/ibeam:latest

# Install 2FA tooling, NTP sync, and virtual display dependencies
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    oathtool \
    chrony \
    xvfb \
    libxi6 \
    libgconf-2-4 \
    libnss3 \
    libxss1 \
    libasound2 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Configure chrony for container clock sync (HIGH-02 fix).
# Uses Google and pool.ntp.org time servers for redundancy.
# makestep 1.0 3: if clock is off by >1s, step immediately (up to 3 times).
RUN printf '%s\n' \
    'server time.google.com iburst' \
    'server time1.google.com iburst' \
    'server pool.ntp.org iburst' \
    'makestep 1.0 3' \
    'rtcsync' \
    > /etc/chrony/chrony.conf

# Copy 2FA generation script
COPY scripts/generate_2fa.py /opt/ibeam/generate_2fa.py

# Environment variables (injected by Railway/docker-compose)
ENV IBEAM_GATEWAY_TYPE=paper
ENV DISPLAY=:99

# Health check — verify IB Gateway is accepting connections
HEALTHCHECK --interval=30s --timeout=10s --retries=5 --start-period=90s \
    CMD curl -sf http://localhost:5000/v1/api/tickle || exit 1

EXPOSE 4001 5000
