# OniQuant v6.0 — Environment Variables
# Used by docker-compose and Railway.app

# --- Application ---
DEBUG=false
LOG_LEVEL=10

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=20

# --- TimescaleDB ---
DATABASE_URL=postgresql://oniquant:oniquant@timescaledb:5432/oniquant
DB_MIN_POOL_SIZE=5
DB_MAX_POOL_SIZE=20

# --- IBKR (IBeam) ---
IBKR_USER=
IBKR_PASSWORD=
IBKR_2FA_SECRET=
IB_GATEWAY_HOST=ibeam-gateway
IB_GATEWAY_PORT=4001
IB_CLIENT_ID=1

# --- Bybit V5 ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# --- Static Egress IP ---
# IBKR: must be whitelisted in Account Management → Settings → API → Trusted IPs
# Bybit: must match IP binding on API key at bybit.com/app/user/api-management
# Railway.app: use "Static Outbound IPs" add-on and paste the IP here
STATIC_EGRESS_IP=
SOCKS5_PROXY=
EGRESS_PROXY_ENABLED=false

# --- Orchestrator ---
POSTERIOR_FLOOR=0.695
ADVERSE_SELECTION_PENALTY=0.20

# --- Streams ---
STREAM_MAXLEN=50000
MATCH_STREAM_MAXLEN=25000
EXEC_STREAM_MAXLEN=25000
